snippet doc "ajout du début du document" Ab
\documentclass[12pt, letterpaper]{article}
\usepackage[${1:french}]{tommyTeX}

\begin{document}

	${0}

\end{document}
endsnippet 

snippet pto "document avec page titre" Ab
\documentclass[12pt, letterpaper]{article}
\usepackage[${1:french}]{tommyTeX}
\title{${2}}
\cours{${3}}
\prof{${4}}
\dateremise{${5}}
\author{Tommy Roy}
${6}
\maketitlepage

\begin{document}

	${0}

\end{document}
endsnippet


snippet aut "auteur" Ab
\author{${0}}
endsnippet

snippet ref "ref" A
\ref{${1}}
endsnippet

snippet cite "cite" A
\cite{${1}}
endsnippet




snippet today "Date"
`date +%F`
endsnippet

snippet par "paragraphe" bA
\paragraph{${1}} 
endsnippet

snippet sec "section" bA
\section{${1}} 
endsnippet

snippet thm "theorem" bA
\begin{theorem}
	${1}
\end{theorem}
endsnippet

snippet pro "proof" bA
\begin{proof}
	${1}
\end{proof}
endsnippet
