% Redéfini \frac pour mettre 1/x lorsque le premier argument est laissé vide ou est simplement omis
\let\oldfrac\frac
\let\frac\undefined
\DeclareDocumentCommand\crac{ s m g }
{
	\IfBooleanTF{#1}
	{\let\fractype\flatfrac}
	{\let\fractype\oldfrac}
	\IfNoValueTF{#3}
	{
		\fractype{1}{#2}
	}
	{
    \ifthenelse{\equal{#2}{}}
    {\fractype{1}{#3}}
    {\fractype{#2}{#3}}
	}
}
\let\frac\crac
\let\crac\undefined

\newcommand{\sqfr}[2]{\sqrt{\frac{#1}{#2}}} % Racine de fraction
\newcommand{\frsq}[2]{\frac{#1}{\sqrt{#2}}} % Racine au déno

% Intégrale personnalisé pour les intégrales avec des bornes infini
\newcommand{\inft}[2]{\int^{#2}_{#1}}

    \let\oldinft\inft
    \let\inft\undefined
    \DeclareDocumentCommand\inftrac{ s g }
    {
        \IfBooleanTF{#1}
        {
            \IfNoValueTF{#2}
            {
                \oldinft{\infty}{-\infty}
            }
            {
                \ifthenelse{\equal{#2}{}}
                {\oldinft{-\infty}{0}}
                {\oldinft{-\infty}{#2}}
            }
        }
        {
            \IfNoValueTF{#2}
            {
                \oldinft{-\infty}{\infty}
            }
            {
                \ifthenelse{\equal{#2}{}}
                {\oldinft{0}{\infty}}
                {\oldinft{#2}{\infty}}
            }
        }
    }
    \let\inft\inftrac
    \let\inftrac\undefined

% Évaluation personnalisé pour les intégrales avec des bornes infini
\newcommand{\evalf}[2]{\eval^{#2}_{#1}}

    \let\oldevalf\evalf
    \let\evalf\undefined
    \DeclareDocumentCommand\evalfrac{ s g }
    {
    	\IfBooleanTF{#1}
        {
            \IfNoValueTF{#2}
            {
                \oldevalf{\infty}{-\infty}
            }
            {
                \ifthenelse{\equal{#2}{}}
                {\oldevalf{-\infty}{0}}
                {\oldevalf{-\infty}{#2}}
            }
        }
        {
            \IfNoValueTF{#2}
            {
                \oldevalf{-\infty}{\infty}
            }
            {
                \ifthenelse{\equal{#2}{}}
                {\oldevalf{0}{\infty}}
                {\oldevalf{#2}{\infty}}
            }
        }
    }
    \let\evalf\evalfrac
    \let\evalfrac\undefined

% Somme personnalisé pour les somme infini
\newcommand{\suminf}[2]{\sum\limits_{#1 = #2}^{\infty}}% somme à l'infini

    %permet de rendre optionnel le premier argument en mettant n= par défaut 
    \let\oldsuminf\suminf
    \let\suminf\undefined
    \DeclareDocumentCommand\srac{ g g }
    {
    	\IfNoValueTF{#2}
    	{
    		\IfNoValueTF{#1}
            {
            \oldsuminf{\text{n}}{0}
            }
            {
            \oldsuminf{\text{n}}{#1}
            }
    	}
    	{
        \ifthenelse{\equal{#1}{}}
        {\oldsuminf{\text{n}}{#2}}
        {\oldsuminf{#1}{#2}}
    	}
    }
    \let\suminf\srac
    \let\srac\undefined

% Produit personnalisé pour les produits infini 
\newcommand{\Pinf}[2]{\prod\limits_{#1 = #2}^{\infty}}

    %permet de rendre optionnel le premier argument en mettant n= par défaut 
    \let\oldPinf\Pinf
    \let\Pinf\undefined
    \DeclareDocumentCommand\Prac{ g g }
    {
    	\IfNoValueTF{#2}
    	{
    		\IfNoValueTF{#1}
            {
            \oldPinf{\text{n}}{0}
            }
            {
            \oldPinf{\text{n}}{#1}
            }
    	}
    	{
        \ifthenelse{\equal{#1}{}}
        {\oldPinf{\text{n}}{#2}}
        {\oldPinf{#1}{#2}}
    	}
    }
    \let\Pinf\Prac
    \let\Prac\undefined

%limite qui tend vers l'infini
\newcommand{\limf}[2]{\lim\limits_{#1 \rightarrow #2}}

    %permet de rendre optionnel le premier argument en mettant n= par défaut 
    \let\oldlimf\limf
    \let\limf\undefined
    \DeclareDocumentCommand\limfrac{ s g }
    {
    	\IfBooleanTF{#1}
    	{
    		\oldlimf{#2}{-\infty}
    	}
    	{
            \oldlimf{#2}{\infty}
    	}
    }
    \let\limf\limfrac
    \let\limfrac\undefined

% limite qui tend vers 0
\newcommand{\flim}[2]{\lim\limits_{#1 \rightarrow #2}}

    \let\oldflim\flim
    \let\flim\undefined
    \DeclareDocumentCommand\flrac{ g g }
    {
    	\IfNoValueTF{#1}
    	{
    		\oldflim{\epsilon}{0}
    	}
    	{
            \IfNoValueTF{#2}
            {
            \oldflim{#1}{0}
            }
            {
            \oldflim{#1}{#2}
            }
    	}
    }
    \let\flim\flrac
    \let\flrac\undefined

%limite qui tend vers 0+-
\newcommand{\limo}[2]{\lim\limits_{#1 \rightarrow #2}}

    %permet de rendre optionnel le premier argument en mettant n= par défaut 
    \let\oldlimo\limo
    \let\limo\undefined
    \DeclareDocumentCommand\orac{ s g }
    {
    	\IfBooleanTF{#1}
    	{
    		\IfNoValueTF{#2}
            {
            \oldlimo{\epsilon}{0^+}
            }
            {
            \ifthenelse{\equal{#2}{}}
            {\oldlimo{\epsilon}{0^+}}
            {\oldlimo{#2}{0^+}}
            }
    	}
    	{
            \IfNoValueTF{#2}
            {
            \oldlimo{\epsilon}{0^-}
            }
            {
            \ifthenelse{\equal{#2}{}}
            {\oldlimo{\epsilon}{0^-}}
            {\oldlimo{#2}{0^-}}
            }
    	}
    }
    \let\limo\orac
    \let\orac\undefined

