\newcommand{\eqriemann}[5][\lambda]{\riemann{#2}{#3#4#5} = \partial_{#4}\chris{#2}{#3#5}-\partial_{#5}\chris{#2}{#3#4} + \chris{#2}{#4#1}\chris{#1}{#3#5}-\chris{#2}{#5#1}\chris{#1}{#3#4}} % Riemann Tensor Equation

