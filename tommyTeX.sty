% --- Gestion dynamique des auteurs ---
\newcounter{authorcount}
\newcounter{authoridx}
\newcommand{\authorslist}{}
\renewcommand{\author}[1]{%
    \listadd{\authorslist}{#1}%
    \stepcounter{authorcount}%
}
 
\newcommand{\printauthors}{%
    \ifnum\value{authorcount}=1
        % Un seul auteur
        \dolistloop{\authorslist}%
    \else
        % Plusieurs auteurs
        \setcounter{authoridx}{0}%
        \renewcommand*{\do}[1]{%
            \stepcounter{authoridx}%
            \ifnum\value{authoridx}>1
                \ifnum\value{authoridx}=\value{authorcount}
                    \space et~##1%
                \else
                    ,~##1%
                \fi
            \else
                ##1%
            \fi
        }%
        \dolistloop{\authorslist}%
    \fi
}
 
% --- Template de Page Titre ---
\newcommand{\maketitlepage}{
    \begin{titlepage}
        \centering
        \includegraphics[width=4cm]{Logo_Ulaval.jpg}\\
        {\large Département de physique, de génie physique et d'optique\\[4cm]}
        
        {\LARGE\bfseries \@title \\[3cm]}
        
        {\large Travail remis à\\[0.3cm]
        \@prof \\[2cm]}
        
        {\large Par\\[0.3cm]
        \printauthors \\[3cm]}
        
        {\large Cours : \@cours \\[0.2cm]
        Date de remise : \@dateremise}
        
        \vfill
    \end{titlepage}
}




